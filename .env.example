# 로컬 환경 설정 템플릿. 이 파일에는 실제 비밀 값을 넣지 마세요.
# 복사해서 .env 를 만든 뒤 그 파일에만 값을 넣습니다:  Copy-Item .env.example .env
# Graph API 버전: 2026-11-04 출시된 v27.0 (공식 changelog 확인 2026-11-21)
META_GRAPH_API_VERSION=v27.0
META_ACCESS_TOKEN=
META_IG_USER_ID=

# 처음 한 번 토큰 설정용: Meta 개발자 앱 > 앱 설정 > 기본 설정 에 있는 앱 ID / 앱 시크릿
META_APP_ID=
META_APP_SECRET=

# 사진 검색 (선택): https://pixabay.com/api/docs/ 에 로그인하면 키가 보임
PIXABAY_API_KEY=
# Pexels 는 2026-11 현재 신규 키 발급 중단. 이미 있는 키만 사용 가능
PEXELS_API_KEY=

# 국내 뉴스 후보 (선택): https://developers.naver.com 에서 '검색' API 애플리케이션 등록
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
